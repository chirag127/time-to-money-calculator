---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: About & Vision -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="brand-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>Time to Money</span>
          </div>
          <p class="brand-desc">
            A production-grade financial planning toolkit answering human questions about wealth targets, compound growth, inflation, and financial freedom.
          </p>
          <div class="privacy-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>100% Client-Side • Calculations stay in your browser</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Popular Calculators -->
      <div class="footer-col">
        <h4 class="col-title">Popular Calculators</h4>
        <ul class="footer-links">
          <li><a href={`${base}/calculators/time-to-money-calculator/`}>Time to Target Calculator</a></li>
          <li><a href={`${base}/calculators/1-crore-calculator/`}>₹1 Crore Goal Calculator</a></li>
          <li><a href={`${base}/calculators/sip-calculator/`}>SIP Return Calculator</a></li>
          <li><a href={`${base}/calculators/future-value-calculator/`}>Future Value Calculator</a></li>
          <li><a href={`${base}/calculators/cagr-calculator/`}>CAGR Calculator</a></li>
          <li><a href={`${base}/calculators/swp-calculator/`}>SWP / Withdrawal Calculator</a></li>
          <li><a href={`${base}/calculators/`}>View All 17+ Calculators →</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources & Learn -->
      <div class="footer-col">
        <h4 class="col-title">Learn & Guides</h4>
        <ul class="footer-links">
          <li><a href={`${base}/learn/`}>Financial Mathematics Hub</a></li>
          <li><a href={`${base}/guides/rule-of-72/`}>The Rule of 72 Explained</a></li>
          <li><a href={`${base}/guides/sip-vs-lumpsum/`}>SIP vs Lump Sum Investing</a></li>
          <li><a href={`${base}/guides/inflation-impact/`}>Real vs Nominal Returns</a></li>
          <li><a href={`${base}/privacy/`}>Privacy Policy</a></li>
          <li><a href={`${base}/terms/`}>Terms of Service</a></li>
        </ul>
      </div>

      <!-- Col 4: Creator Info & Socials -->
      <div class="footer-col creator-col">
        <h4 class="col-title">About the Creator</h4>
        <p class="creator-bio">
          Built with care by <strong>Chirag Singhal</strong>, Software Engineer from India. Passionate about empowering individuals with transparent, world-class personal finance tools.
        </p>
        <div class="social-links">
          <a href="https://github.com/chirag127/" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href="https://www.linkedin.com/in/chirag127/" target="_blank" rel="noopener noreferrer" title="LinkedIn" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="https://x.com/singhal127" target="_blank" rel="noopener noreferrer" title="X (Twitter)" aria-label="X">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
          </a>
          <a href="https://www.youtube.com/@ChiragSinghal127" target="_blank" rel="noopener noreferrer" title="YouTube" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
          <a href="https://www.instagram.com/chiragsinghal127/" target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://www.reddit.com/user/Far_Macaron_9910/" target="_blank" rel="noopener noreferrer" title="Reddit" aria-label="Reddit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
          </a>
        </div>
        <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener noreferrer" class="coffee-btn">
          ☕ Buy Me a Coffee
        </a>
      </div>
    </div>

    <!-- Legal & Mathematical Disclaimer -->
    <div class="footer-disclaimer">
      <div class="disclaimer-header">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <strong>Mathematical & Financial Disclaimer</strong>
      </div>
      <p>
        This calculator provides mathematical estimates based on the assumptions and inputs you enter. It is not investment, tax, legal, or financial advice. Actual returns, taxes, fees, inflation, and investment outcomes may differ significantly due to market volatility and personal circumstances. Consult a SEBI-registered or certified financial advisor before making financial decisions.
      </p>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Time to Money Calculator • Made with care by <a href={`${base}/about/`}>Chirag Singhal</a>.</p>
      <div class="footer-bottom-links">
        <a href={`${base}/privacy/`}>Privacy</a>
        <span>•</span>
        <a href={`${base}/terms/`}>Terms</a>
        <span>•</span>
        <a href={`${base}/contact/`}>Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    padding: 3.5rem 0 2rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--accent-primary);
    margin-bottom: 0.75rem;
  }

  .brand-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--accent-primary);
  }

  .creator-bio {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .social-links {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .social-links a {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: all 0.15s ease;
  }

  .social-links a:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background: var(--accent-primary-light);
  }

  .coffee-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 700;
    background: #ffdd00;
    color: #000000;
    border-radius: var(--radius-md);
    transition: transform 0.15s ease;
  }

  .coffee-btn:hover {
    transform: translateY(-1px);
  }

  .footer-disclaimer {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-amber);
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  .footer-disclaimer p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-bottom-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-bottom-links a {
    color: var(--text-muted);
  }

  .footer-bottom-links a:hover {
    color: var(--accent-primary);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
