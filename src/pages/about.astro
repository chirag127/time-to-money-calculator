---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="About Chirag Singhal & Time to Money Calculator"
  description="Learn about the creator behind Time to Money Calculator — Chirag Singhal, Software Engineer from India. Dedicated to transparent, privacy-first financial engineering."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' }
  ]}
>
  <div class="about-page">
    <div class="container about-container">
      <div class="about-card">
        <span class="badge badge-emerald">Creator Profile</span>
        <h1>About Chirag Singhal</h1>
        <p class="role-subtitle">Software Engineer • India</p>

        <div class="bio-text">
          <p>
            Hello! I am <strong>Chirag Singhal</strong>, a software engineer with a deep passion for building high-utility, beautiful, and mathematically rigorous web tools.
          </p>
          <p>
            I designed and engineered the <strong>Time to Money Calculator</strong> because most existing financial calculators online are either basic interest toys, cluttered with ads, or force users to register and give away private financial information.
          </p>
          <p>
            The philosophy of Time to Money is simple:
          </p>
          <ul class="principles-list">
            <li><strong>100% Client-Side Privacy:</strong> Your numbers, salaries, and wealth targets never leave your browser. Zero backend logging, zero tracking databases.</li>
            <li><strong>Answer Human Questions:</strong> Rather than forcing users to solve complex algebraic equations, the tool directly answers questions like <em>"When will I reach ₹1 Crore?"</em> or <em>"How much should I invest every month?"</em></li>
            <li><strong>Mathematical Rigor:</strong> Accurate periodic compounding simulations that account for cash flow timing, step-up SIP hikes, inflation erosion, and net taxes.</li>
          </ul>
        </div>

        <h2 class="socials-heading">Connect With Me</h2>
        <div class="social-links-grid">
          <a href="https://github.com/chirag127/" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">GitHub</span>
            <span class="social-handle">@chirag127</span>
          </a>
          <a href="https://www.linkedin.com/in/chirag127/" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">LinkedIn</span>
            <span class="social-handle">in/chirag127</span>
          </a>
          <a href="https://x.com/singhal127" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">X (Twitter)</span>
            <span class="social-handle">@singhal127</span>
          </a>
          <a href="https://www.youtube.com/@ChiragSinghal127" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">YouTube</span>
            <span class="social-handle">@ChiragSinghal127</span>
          </a>
          <a href="https://www.instagram.com/chiragsinghal127/" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">Instagram</span>
            <span class="social-handle">@chiragsinghal127</span>
          </a>
          <a href="https://www.reddit.com/user/Far_Macaron_9910/" target="_blank" rel="noopener noreferrer" class="social-card">
            <span class="social-name">Reddit</span>
            <span class="social-handle">u/Far_Macaron_9910</span>
          </a>
        </div>

        <div class="support-banner">
          <div>
            <h3>Support This Free Project</h3>
            <p>If this calculator helped you clarify your financial goals or plan your retirement, consider supporting future development.</p>
          </div>
          <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener noreferrer" class="coffee-button">
            ☕ Buy Me a Coffee
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 3.5rem 0 5rem;
  }

  .about-container {
    max-width: 820px;
  }

  .about-card {
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  h1 {
    margin: 0.5rem 0 0.25rem;
  }

  .role-subtitle {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
  }

  .bio-text p {
    font-size: 1.02rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  .principles-list {
    margin: 1.25rem 0 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .principles-list li {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .socials-heading {
    font-size: 1.25rem;
    margin: 2rem 0 1rem;
  }

  .social-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .social-card {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    transition: all 0.15s ease;
  }

  .social-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }

  .social-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .social-handle {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .support-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .support-banner h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .support-banner p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .coffee-button {
    background: #ffdd00;
    color: #000000;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .coffee-button:hover {
    transform: translateY(-2px);
  }
</style>
