---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Contact — Time to Money Calculator"
  description="Get in touch with Chirag Singhal, creator of Time to Money Calculator. Feature requests, feedback, bug reports, and collaborations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' }
  ]}
>
  <div class="contact-page">
    <div class="container contact-container">
      <div class="contact-card">
        <span class="badge badge-emerald">Get in Touch</span>
        <h1>Contact & Feedback</h1>
        <p class="contact-sub">
          Have an idea for a new financial calculator mode, spotted a calculation discrepancy, or want to collaborate? I would love to hear from you.
        </p>

        <div class="contact-methods-grid">
          <div class="contact-box">
            <span class="box-icon">✉️</span>
            <h3>Email</h3>
            <p>Direct inquiries and feedback:</p>
            <a href="mailto:chirag@oriz.in" class="contact-link">chirag@oriz.in</a>
          </div>

          <div class="contact-box">
            <span class="box-icon">🐙</span>
            <h3>GitHub Issues</h3>
            <p>Report bugs or request formulas:</p>
            <a href="https://github.com/chirag127/time-to-money-calculator/issues" target="_blank" rel="noopener noreferrer" class="contact-link">
              Open an Issue →
            </a>
          </div>

          <div class="contact-box">
            <span class="box-icon">🐦</span>
            <h3>Social Channels</h3>
            <p>Fastest way to say hi:</p>
            <a href="https://x.com/singhal127" target="_blank" rel="noopener noreferrer" class="contact-link">
              @singhal127 on X →
            </a>
          </div>
        </div>

        <div class="faq-note">
          <h4>Looking for Financial Advice?</h4>
          <p>
            Please note that as a software engineer, I build mathematical models and software tools, but I cannot provide personalized investment advice or portfolio management services.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page { padding: 3.5rem 0 5rem; }
  .contact-container { max-width: 820px; }
  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }
  h1 { margin: 0.5rem 0 0.5rem; }
  .contact-sub {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .contact-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .contact-box {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .box-icon { font-size: 1.75rem; margin-bottom: 0.5rem; }
  .contact-box h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
  .contact-box p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; }
  .contact-link {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-top: auto;
  }
  .contact-link:hover { text-decoration: underline; }
  .faq-note {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }
  .faq-note h4 { font-size: 0.95rem; margin-bottom: 0.35rem; }
  .faq-note p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin: 0; }
</style>
