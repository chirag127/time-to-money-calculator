---
import CalculatorPageShell from '../../components/CalculatorPageShell.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const workedExample = {
  title: 'Achieving ₹5 Crore Milestone at 13% Return with ₹45,000/mo SIP',
  description: 'Simulating an aggressive 18-year wealth accumulation journey to reach high-net-worth status.',
  steps: [
    { label: 'Target Wealth Milestone', value: '₹5,00,00,000 (₹5 Crore)' },
    { label: 'Starting Savings', value: '₹5,00,000' },
    { label: 'Monthly SIP', value: '₹45,000' },
    { label: 'Expected Return', value: '13% p.a.' },
    { label: 'Total Capital Invested', value: '₹1,02,20,000 (~1.02 Crore)' },
    { label: 'Wealth Generated by Compounding', value: '₹3,97,80,000 (~80% of corpus)' }
  ],
  result: '₹5 Crore achieved in 18 Years with 80% coming from compound growth!'
};

const faqItems = [
  {
    question: 'How much does it take to reach multi-crore goals (₹2 Cr, ₹5 Cr, ₹10 Cr)?',
    answer: 'The first crore takes the longest due to linear contributions dominating early on. The subsequent crores compound exponentially faster—often requiring less than half the time of the first crore.'
  },
  {
    question: 'Why does the 2nd and 3rd crore accumulate so much faster?',
    answer: 'Because of compound interest momentum! On a ₹1 Crore portfolio at 12%, annual interest alone generates ₹12 Lakhs—often more than your entire annual salary savings. By ₹2 Crore, it earns ₹24 Lakhs per year without any fresh deposits.'
  }
];

const relatedCalculators = [
  { title: '1 Crore Calculator', desc: 'Focus specifically on the first ₹1 Crore milestone.', path: `${base}/calculators/1-crore-calculator/` },
  { title: '10 Lakh to 1 Crore Calculator', desc: 'Accelerate existing capital 10x.', path: `${base}/calculators/10-lakh-to-1-crore-calculator/` },
  { title: 'Time to Target Calculator', desc: 'Calculate timeline for any custom target.', path: `${base}/calculators/time-to-money-calculator/` }
];
---

<CalculatorPageShell
  title="Crore Calculator — Multi-Crore Wealth Goal Planner (₹1 Cr to ₹10 Cr)"
  description="Plan multi-crore wealth goals. Calculate timelines, monthly SIPs, and compounding acceleration for ₹2 Crore, ₹5 Crore, and ₹10 Crore targets."
  badge="Multi-Crore Wealth"
  headline="Crore Wealth Planner"
  subheadline="Master the physics of exponential wealth. Discover why each subsequent crore accumulates faster than the last."
  initialMode="time"
  initialTarget={50000000}
  initialCurrent={1000000}
  initialReturn={13}
  initialMonthly={45000}
  formulaTitle="Multi-Crore Compounding Acceleration"
  formulaCode="Annual Interest = Corpus × Return Rate"
  formulaExplanation="<p>At ₹1 Crore, a 12% return generates ₹12,00,000/year (~₹1 Lakh/month) purely in passive returns. At ₹5 Crore, that same 12% return produces ₹60,00,000/year (₹5 Lakh/month), far eclipsing human labor income.</p>"
  workedExample={workedExample}
  faqItems={faqItems}
  relatedCalculators={relatedCalculators}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Calculators', url: '/calculators/' },
    { name: 'Crore Calculator', url: '/calculators/crore-calculator/' }
  ]}
/>
